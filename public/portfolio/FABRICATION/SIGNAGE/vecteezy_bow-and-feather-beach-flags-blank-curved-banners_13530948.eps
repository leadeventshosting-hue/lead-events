   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Bow and feather beach flags, blank curved wind banners templates. Vertical signboards for outdoor city advertising. Expo stands mockup isolated on white background, Realistic 3d vector mock up set</rdf:li>
